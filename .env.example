# 环境配置
FLASK_ENV=development
FLASK_DEBUG=True

# 服务端口
OCR_SERVICE_PORT=5000
NLP_SERVICE_PORT=5001
HEALTH_CHECK_PORT=5002

# 模型/设备
USE_GPU=True
MODEL_PATH=./models

# OCR
OCR_LANGUAGE=ch
OCR_USE_ANGLE_CLS=True
OCR_CONFIDENCE_THRESHOLD=0.7

# NLP
NLP_MODEL_NAME=bert-base-chinese
NER_CONFIDENCE_THRESHOLD=0.75

# =========================
# LLM 兜底（全部使用 NVIDIA）
# =========================
ENABLE_LLM_FALLBACK=True
# 提供商改为 nvidia
LLM_PROVIDER=nvidia
# NVIDIA API Key（用你自己的）
LLM_API_KEY_NVIDIA=
# 多模态模型（图片 / PDF）
LLM_MODEL_VISION=nvidia/nemotron-nano-12b-v2-vl
# 文本模型（普通问答 / Agent）
LLM_MODEL_TEXT=nvidia/llama-3.3-nemotron-super-49b-v1.5
# 重试次数
LLM_RETRY=1
# NVIDIA 接口
LLM_ENDPOINT=https://integrate.api.nvidia.com/v1
# 是否使用系统代理
LLM_TRUST_ENV=True

# 日志
LOG_LEVEL=INFO
LOG_PATH=./logs

# 性能
MAX_WORKERS=4
REQUEST_TIMEOUT=60
