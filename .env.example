# 环境配置
FLASK_ENV=development
FLASK_DEBUG=True

# 服务端口
OCR_SERVICE_PORT=5005
NLP_SERVICE_PORT=5001
HEALTH_CHECK_PORT=5002

# 模型/设备
USE_GPU=True
MODEL_PATH=./models

# OCR
OCR_LANGUAGE=ch
OCR_USE_ANGLE_CLS=True
OCR_CONFIDENCE_THRESHOLD=0.7

# NLP
NLP_MODEL_NAME=bert-base-chinese
NER_CONFIDENCE_THRESHOLD=0.75

# LLM 兜底（仅 Qwen：文本 qwen-plus，读图 qwen3-vl-plus）
ENABLE_LLM_FALLBACK=True
LLM_PROVIDER=qwen
# Qwen 密钥需自行填写
LLM_API_KEY_QWEN=
LLM_MODEL_QWEN=qwen3-vl-plus
LLM_MODEL_QWEN_TEXT=qwen-plus
LLM_RETRY=1
LLM_ENDPOINT_QWEN=https://dashscope.aliyuncs.com/compatible-mode/v1
# 如需走系统代理/证书，设为 True
LLM_TRUST_ENV=True

# 日志
LOG_LEVEL=INFO
LOG_PATH=./logs

# 性能
MAX_WORKERS=4
REQUEST_TIMEOUT=60
